<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee https://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
 <display-name>RestMan6</display-name>
 <request-character-encoding>UTF-8</request-character-encoding>
 <response-character-encoding>UTF-8</response-character-encoding>
 <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
 <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
 <error-page><error-code>500</error-code><location>/view/Error6.jsp</location></error-page>
 <error-page><error-code>404</error-code><location>/view/Error6.jsp</location></error-page>
</web-app>

